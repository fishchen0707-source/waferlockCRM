# 照片遷移前的本機備份（含 base64，勿進版控）
_photo_backup/

# 改檔前的本機備份（原檔名.backup_YYYYMMDD，勿進版控）
*.backup_*

# Node 相依（各子專案）
node_modules/

# Python 編譯快取
__pycache__/
*.pyc

# 本機密鑰（勿進版控）
secret.txt
*.env.local

# 本機測試錄音（可能含語音，勿進版控）
stt-worker/*.wav
stt-worker/*.m4a
stt-worker/*.mp3

# 去識別化資料集（含個資，勿進版控）
LINE DATA/

# 教育訓練手冊的單檔版：4.5MB 的產物，用 教育訓練與流程/產生單檔版.py 重產即可
教育訓練與流程/派工出貨手冊_單檔版.html
教育訓練與流程/派工出貨手冊.pdf
教育訓練與流程/img/_pdf_slices/

# Skype 對話紀錄：含真實客戶姓名、電話、地址，勿進版控
teams對話紀錄/

# 歷史料號 CSV：由 scripts/analyze-shipment-history.py 從 Skype 紀錄重產的**快照**。
# 不進版控的理由同「下單規格表」——它是衍生產物，進 git 會變成第二份副本、遲早跟來源不一致。
# 要的人跑一次腳本就有。
docs/歷史料號_*.csv
